rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products & categories & collections: anyone can read (it's a public
    // storefront), only a signed-in admin can write. There's no public
    // sign-up page in this app, so any authenticated user IS the admin —
    // see README.md "Firebase Setup" for how the admin account is created.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create an order (customers aren't logged in), but
    // only an admin can read or modify them afterwards. No update/delete
    // for unauthenticated users — orders cannot be tampered with once placed.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Settings: public read (the storefront may read store contact info),
    // admin-only write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
